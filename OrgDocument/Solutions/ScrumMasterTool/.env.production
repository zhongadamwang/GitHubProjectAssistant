# ─────────────────────────────────────────────
# Application (Production)
# ─────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_BASE_PATH=

# ─────────────────────────────────────────────
# Database (MySQL via PDO)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scrum_dashboard
DB_USER=scrum_user
DB_PASS=scrum_pass
DB_CHARSET=utf8mb4
DB_DATABASE=scrum_dashboard
DB_USERNAME=scrum_user
DB_PASSWORD=scrum_pass

# ─────────────────────────────────────────────
# Repository API (GraphQL v4)
# ─────────────────────────────────────────────
# Personal Access Token with read:project and read:org scopes
REPO_PAT=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
REPO_ORG=Sanjel-Energy-Services
REPO_PROJECT_NUMBER=22
REPO_GRAPHQL_URL=https://api.github.com/graphql

# ─────────────────────────────────────────────
# PHP Sessions
# ─────────────────────────────────────────────
SESSION_NAME=scrum_session
SESSION_LIFETIME=28800
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=warning
LOG_PATH=../data/logs/app.log
