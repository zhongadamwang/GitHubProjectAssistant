# ─────────────────────────────────────────────
# Production TEMPLATE — contains NO secrets.
# On the server copy this to .env (cp .env.production .env), fill in the blanks
# and run chmod 600 .env. Never commit real passwords, tokens or keys.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Application (Production)
# ─────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_BASE_PATH=

# ─────────────────────────────────────────────
# Credential encryption key (required) — generate on the server with:
#   php cron/generate-app-key.php
# It encrypts the GitHub tokens stored by Admin → GitHub accounts. Back it up.
# ─────────────────────────────────────────────
APP_KEY=

# ─────────────────────────────────────────────
# Database (MySQL via PDO)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scrum_dashboard
DB_USER=scrum_user
DB_PASS=
DB_CHARSET=utf8mb4
DB_DATABASE=scrum_dashboard
DB_USERNAME=scrum_user
DB_PASSWORD=

# ─────────────────────────────────────────────
# GitHub
# ─────────────────────────────────────────────
# Accounts, tokens and projects are managed in the app (Admin → GitHub accounts / Projects).
# The legacy REPO_PAT / REPO_ORG / REPO_PROJECT_NUMBER settings are no longer needed once
# `php cron/import-env-account.php` has been run — leave them out of new installations.
REPO_GRAPHQL_URL=https://api.github.com/graphql

# ─────────────────────────────────────────────
# PHP Sessions
# ─────────────────────────────────────────────
SESSION_NAME=scrum_session
SESSION_LIFETIME=28800
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=warning
LOG_PATH=../data/logs/app.log
